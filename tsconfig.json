{
  "compilerOptions": {
    "types": ["react", "react-dom"],
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext", "ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "css.d.ts",
    "types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "app/lib/db/import dataModels from \"./models\"; import { capitalize } from \"../utils\"; import { connectToDB } from \"./utilsDB\";"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "public",
    "**/*.test.js",
    "**/__tests__",
    "**/*.spec.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "src/__tests__",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx"
  ]
}
